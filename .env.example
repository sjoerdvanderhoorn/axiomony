# Choose: ./scripts/start.sh bundled OR ./scripts/start.sh external
# Bundled mode configures database host and port internally.
# In external mode, configure the host, port, and database below.
# PostgreSQL user passwords must never be stored here in either deployment mode.
PGHOST=host.docker.internal
PGPORT=5432
PGDATABASE=my_business_database
PGSSL=false
PGSSL_REJECT_UNAUTHORIZED=true

# MCP listener, bound only to localhost by the default Docker Compose mapping.
PORT=3000
# Optional. Hostnames allowed in Host/Origin headers, comma-separated.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
# Max accepted POST body in bytes.
MAX_BODY_BYTES=2097152

# Optional: only needed for manage_database (natural-language administrator).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Plan expires after this many minutes. In-memory, lost on restart.
PLAN_TTL_MINUTES=20

# AI-generated pages use Data-MCP (see app_integration_guide).
# Existing REST helper tools are HIDDEN by default; explicitly opt in:
REST_MCP_TOOLS=false

# Optional direct PostgREST API (still started by scripts/start.sh for compatibility).
# For a browser app, public URLs must be changed to your HTTPS domain.
REST_PUBLIC_URL=http://localhost:3001
REST_TOKEN_URL=http://localhost:3000/auth/token
# Only schemas in this list are exposed. Use 'public' for the simplest setup.
REST_EXPOSED_SCHEMAS=public
# Comma-separated exact browser app origins for token endpoint and REST CORS.
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional static hosting for AI-generated HTML/CSS/JS applications.
# When enabled, ./scripts/start.sh also starts a ready-made Nginx container.
APP_HOSTING_ENABLED=false
APP_PUBLIC_URL=http://localhost:8088
# Loopback-only by default; use an HTTPS reverse proxy for any public deployment.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8088
APP_MAX_FILE_BYTES=1048576
# Base64 files (up to 1 MiB) require a larger MCP request size limit:
# MAX_BODY_BYTES=2097152
