# Axiomony has two Docker deployments:
# External Database: docker compose up -d --build
# Standalone: docker compose -f compose.yml -f compose.standalone.yml up -d --build
# Copy this file to .env and configure the required fields. Never commit .env.

# Database name is required in both modes.
PGDATABASE=axiomony

# External Database only: PostgreSQL server location and TLS settings.
# MCP users authenticate with their OWN database credentials on each request.
PGHOST=host.docker.internal
PGPORT=5432
PGSSL=false
PGSSL_REJECT_UNAUTHORIZED=true
PGSSLMODE=prefer

# Standalone only: REQUIRED secure password for the new platform_admin role.
# No password is generated or hardcoded. Keep it safe; a persisted database
# does not change its existing password if this value is later edited.
POSTGRES_BOOTSTRAP_PASSWORD=

# Both modes: REQUIRED distinct password for the limited PostgREST login.
# In External Database mode, create/update that role with the same password.
REST_AUTH_PASSWORD=

# Both modes: REQUIRED random REST JWT signing secret (at least 32 characters).
REST_JWT_SECRET=

# MCP and administration settings.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
MAX_BODY_BYTES=2097152
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
PLAN_TTL_MINUTES=20
REST_MCP_TOOLS=false

# REST clients (local development only; never publish without hardening).
REST_PUBLIC_URL=http://localhost:3001
REST_TOKEN_URL=http://localhost:3000/auth/token
REST_EXPOSED_SCHEMAS=public
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Standalone static HTML/CSS/JS hosting; always on in this deployment.
APP_PUBLIC_URL=http://localhost:8088
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8088
APP_MAX_FILE_BYTES=1048576